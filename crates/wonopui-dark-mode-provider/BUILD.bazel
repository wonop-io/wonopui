load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "wonopui-dark-mode-provider",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "wonopui_dark_mode_provider",
    edition = "2021",
    deps = [
        "//crates/wonopui-core:wonopui-core",
        "//crates/wonopui-media-query:wonopui-media-query",
        "@crates//:web-sys",
        "@crates//:yew",
    ],
)

# Source files for Tailwind CSS scanning
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "wonopui-modal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "wonopui_modal",
    edition = "2021",
    deps = [
        "@crates//:yew",
        "@crates//:web-sys",
        "@crates//:gloo",
        "@crates//:wasm-bindgen",
    ],
)

rust_test(
    name = "wonopui-modal_test",
    crate = ":wonopui-modal",
    size = "small",
)

filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "wonopui-combobox",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "wonopui_combobox",
    edition = "2021",
    deps = [
        "//crates/wonopui-core:wonopui-core",
        "@crates//:gloo-events",
        "@crates//:gloo-timers",
        "@crates//:wasm-bindgen",
        "@crates//:web-sys",
        "@crates//:yew",
    ],
)

# Source files for Tailwind CSS scanning
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "wonopui-code-editor",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "wonopui_code_editor",
    edition = "2021",
    deps = [
        "//crates/wonopui-core:wonopui-core",
        "@crates//:gloo",
        "@crates//:similar",
        "@crates//:wasm-bindgen",
        "@crates//:web-sys",
        "@crates//:yew",
    ],
)

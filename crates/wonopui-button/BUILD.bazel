load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "wonopui-button",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "wonopui_button",
    edition = "2021",
    deps = [
        "//crates/wonopui-core:wonopui-core",
        "@crates//:yew",
    ],
)

rust_test(
    name = "wonopui-button_test",
    crate = ":wonopui-button",
)

# Source files for Tailwind CSS scanning
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

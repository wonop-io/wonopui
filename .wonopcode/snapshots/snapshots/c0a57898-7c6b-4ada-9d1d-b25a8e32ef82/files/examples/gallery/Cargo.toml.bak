[package]
name = "gallery"
version = "0.1.0"
edition = "2021"
description = "Template for starting a Yew project using Trunk"
readme = "README.md"
repository = "https://github.com/yewstack/yew-trunk-minimal-template"
license = "MIT OR Apache-2.0"
keywords = ["yew", "trunk"]
categories = ["gui", "wasm", "web-programming"]

[dependencies]
yew = { version = "0.21", features = ["csr"] }
web-sys = { version = "0.3.68", features = [
    "HtmlDocument",
    "Document",
    "HtmlInputElement",
    "HtmlSelectElement",
    "HtmlTextAreaElement",
    "HtmlIFrameElement",
    "Element",
    "DomRect",
    "HtmlElement",
    "HtmlInputElement",
    "HtmlDivElement",
    "HtmlImageElement",
    "Navigator",
    "Window",
    "Clipboard",
    "DragEvent",
    "DataTransfer",
    "HtmlStyleElement",
    "HtmlLinkElement",
    "ResizeObserver",
    "IntersectionObserver",
    "MutationObserver",
    "CssStyleDeclaration",
    "CustomEvent",
    "CustomEventInit",
    "PointerEvent",
    "KeyboardEvent",
    "KeyboardEventInit",
    "MediaQueryList",
    "MediaQueryListEvent",
    "SvgElement",
    "DomTokenList",
    "EventTarget",
] }
wasm-bindgen = { version = "0.2.90", features = ["serde-serialize"] }
wasm-bindgen-futures = "0.4.40"
serde = { version = "1.0.195", features = ["derive"] }
yewdux = "0.11.0"
serde_json = "1.0.111"
serde-wasm-bindgen = "0.6.3"
yew-router = "0.18.0"
validator = { version = "0.16.0", features = ["derive"] }
chrono = { version = "0.4.23", features = ["serde", "wasmbind"] }
chrono-humanize = "0.2.3"
gloo-console = "0.3.0"
gloo-utils = "0.2.0"
gloo-timers = "0.3.0"
uuid = { version = "1.3.0", features = ["serde", "v4", "js"] }
tracing-web = "0.1.3"
tracing-subscriber = "0.3.18"
futures = "0.3"
reqwest-wasm = { version = "0.11", features = ["json", "stream"] }
bytes = "1.0"
tera = "1.19.1"
gloo-events = "0.2.0"
scraper = "0.19.0"
reqwasm = "0.5.0"
tailwind-css = "0.13.0"
lazy_static = "1.5.0"
log = "0.4.20"

# Use the new wonopui with feature-gated components
wonopui = { path = "../../crates/wonopui", features = [
    "accordion",
    "alert",
    "avatar",
    "badge",
    "breadcrumb",
    "browser-provider",
    "button",
    "calendar",
    "card",
    "carousel",
    "checkbox",
    "col",
    "collapsible",
    "color-picker",
    "combobox",
    "command",
    "container",
    "content",
    "context-menu",
    "copy-button",
    "dark-mode-provider",
    "data-table",
    "date-picker",
    "dialog",
    "diffview",
    "divider",
    "drag-point",
    "drawer",
    "dropdown",
    "group-button",
    "iframe",
    "input",
    "kanban",
    "label",
    "layout",
    "markdown-editor",
    "media-query",
    "mention-input",
    "multicol-sidebar",
    "notification",
    "page-content",
    "page-header",
    "pagination",
    "paint-canvas",
    "placeholder",
    "popover",
    "resizable",
    "select",
    "selectable",
    "sidebar",
    "switch",
    "table",
    "tabs",
    "tag-input",
    "tailwind-color-picker",
    "textarea",
    "toggle",
    "topbar",
    "typography",
    "window-provider",
] }

# This is needed for fixing compatibility after the reorganization
# Enable wasm_js feature for getrandom when targeting WASM
[target.'cfg(target_arch = "wasm32")'.dependencies]
getrandom = { version = "0.3", features = ["wasm_js"] }

[features]
default = []
compat_hooks = []

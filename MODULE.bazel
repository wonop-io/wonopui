"""Bazel module for WonopUI - A Yew UI component library."""

module(
    name = "wonopui",
    version = "0.1.0",
)

# Rust rules
bazel_dep(name = "rules_rust", version = "0.68.1")

# WASM bindgen rules for WebAssembly support
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.68.1")

# Register Rust toolchains (including WASM target)
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.0"],
    extra_target_triples = ["wasm32-unknown-unknown"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Crate universe for managing Cargo dependencies
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/wonopui:Cargo.toml",
        "//crates/wonopui-core:Cargo.toml",
        "//crates/wonopui-accordion:Cargo.toml",
        "//crates/wonopui-alert:Cargo.toml",
        "//crates/wonopui-avatar:Cargo.toml",
        "//crates/wonopui-badge:Cargo.toml",
